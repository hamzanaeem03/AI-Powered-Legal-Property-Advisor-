# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables. Never commit real secrets.

# --- Required -------------------------------------------------------------

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Session signing key: a long random hex string, e.g. `openssl rand -hex 64`.
# Avoid `$` in any value: Next.js treats `$NAME` as a variable reference and silently truncates it.
JWT_SECRET=

# Google Gemini (AI assistant)
GEMINI_API_KEY=

# Public URL of the site (used in email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Document uploads (Cloudinary) -----------------------------------------
# Either the single URL from the Cloudinary dashboard...
CLOUDINARY_URL=
# ...or the three separate values
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (SMTP) ------------------------------------------------------------
# Without these, emails are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# e.g. "Legal Property Advisor" <noreply@yourdomain.com>
SMTP_FROM=

# --- Rate limiting (Upstash Redis) ------------------------------------------
# Required on Vercel for limits to hold across instances. The Vercel Upstash
# integration sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scheduled jobs (Vercel Cron) --------------------------------------------
# Protects /api/cron/* (daily subscription reminders). Vercel sends it automatically
# as "Authorization: Bearer <CRON_SECRET>". Use `openssl rand -hex 32`.
CRON_SECRET=
